# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored and must never be committed.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# 32-byte base64 key for the encrypted Home Assistant API.
# Generate one with:  openssl rand -base64 32
# If the device is already adopted in Home Assistant, keep using the
# existing key - otherwise HA will lose the connection to the device.
api_encryption_key: "GENERATE_ME_WITH_openssl_rand_-base64_32"

# Password for over-the-air firmware updates
ota_password: "ChooseAStrongOtaPassword"

# Password for the fallback hotspot (min. 8 characters)
ap_password: "ChooseAStrongApPassword"
